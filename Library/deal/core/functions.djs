command #parseint:function = parseInt;
command #parsefloat:function = parseFloat;
command #alert:function = alert;
command #confirm:function = confirm;
command #prompt:function = prompt;
command #fetch:function = fetch;
command #urldecode:function = urlDecode;
command #urlencode:function = urlEncode;
command #uriencode:function = encodeURIComponent;
command #uridecode:function = decodeURIComponent;
command #encodeuricomponent:function = encodeURIComponent;
command #decodeuricomponent:function = decodeURIComponent;
command #isnan:function = isNaN;
command #isfinite:function = isFinite;
