<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>MiMFa</RootNamespace>
    <!-- Use SDK default inclusion of source files to avoid duplicate Compile entries -->
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <Company>MiMFa</Company>
    <Product>DaRQ</Product>
    <Authors>Mohammad Fathi (MiMFa)</Authors>
    <ApplicationIcon />
    <OutputType>Library</OutputType>
    <StartupObject></StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="DaRQ\Parser.Legacy.cs" />
    <Compile Remove="JavaScript\Parser.Legacy.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Newtonsoft.Json.dll" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>


  <ItemGroup>
    <None Include="LICENSE" />
    <None Include="README.md" />
    <None Include="SAMPLE.md" />
    <None Include="Samples\DaRQ Tutorial-Example.darq" />
    <None Include="Samples\DaRQ Tutorial-Example.js" />
  </ItemGroup>


  <ItemGroup>
    <Resource Include="Newtonsoft.Json.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>


  <ItemGroup>
    <None Update="DaRQ\Library\darq\data\local.darq">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="DaRQ\Library\darq\data\read.darq">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="DaRQ\Library\darq\core\statements.darq">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="DaRQ\Library\darq\handler\identifiers.darq">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="DaRQ\Library\darq\selector\any.darq">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="DaRQ\Library\darq\selector\one.darq">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="DaRQ\Library\darq\core\operators.darq">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="DaRQ\Library\darq\core\noises.darq">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="DaRQ\Library\darq\core\functions.darq">
